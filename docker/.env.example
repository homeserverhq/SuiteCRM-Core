# SuiteCRM Docker Environment Variables
# All SUITECRM_* vars are mapped to Symfony config in the entrypoint

# Required
SUITECRM_SITE_URL=http://localhost:8040
SUITECRM_APP_SECRET=changeme-please-generate-a-random-string
SUITECRM_DB_PASSWORD=suitecrm
SUITECRM_ADMIN_PASSWORD=admin123

# Database
SUITECRM_DB_HOST=mariadb
SUITECRM_DB_PORT=3306
SUITECRM_DB_NAME=suitecrm
SUITECRM_DB_USER=suitecrm
SUITECRM_DB_ROOT_PASSWORD=root

# Valkey (cache only, no persistence)
SUITECRM_VALKEY_DSN=redis://valkey:6379/0
SUITECRM_VALKEY_PASSWORD=

# Admin user
SUITECRM_ADMIN_USERNAME=admin
SUITECRM_ADMIN_FIRST_NAME=Admin
SUITECRM_ADMIN_LAST_NAME=Administrator

# Application
SUITECRM_APP_ENV=prod
SUITECRM_AUTH_TYPE=native
SUITECRM_SITE_NAME=SuiteCRM
SUITECRM_TRUSTED_PROXIES=172.16.0.0/12
SUITECRM_TRUSTED_HOSTS=

# Mailer
SUITECRM_MAILER_DSN=

# LDAP
SUITECRM_LDAP_HOST=ldap
SUITECRM_LDAP_PORT=389
SUITECRM_LDAP_ENCRYPTION=none
SUITECRM_LDAP_DN_STRING=uid=%s,ou=users,dc=example,dc=com
SUITECRM_LDAP_QUERY_STRING=uid=%s
SUITECRM_LDAP_SEARCH_DN=cn=admin,dc=example,dc=com
SUITECRM_LDAP_SEARCH_PASSWORD=admin
SUITECRM_LDAP_AUTO_CREATE=disabled
SUITECRM_LDAP_PROVIDER_BASE_DN=ou=users,dc=example,dc=com
SUITECRM_LDAP_PROVIDER_SEARCH_DN=ou=users,dc=example,dc=com
SUITECRM_LDAP_PROVIDER_UID_KEY=uid
SUITECRM_LDAP_PROVIDER_FILTER=
SUITECRM_LDAP_PROVIDER_DEFAULT_ROLES=ROLE_USER
SUITECRM_LDAP_GROUP_NAME=primaryusers
SUITECRM_LDAP_GROUP_ATTR=uniqueMember
SUITECRM_LDAP_GROUP_OBJECTCLASS=groupOfUniqueNames
SUITECRM_LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com
